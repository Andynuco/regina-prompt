                                <span class="social-chip" data-net="Facebook"><i class="bi bi-facebook me-1"></i>Facebook</span>
                                <span class="social-chip" data-net="LinkedIn"><i class="bi bi-linkedin me-1"></i>LinkedIn</span>
                            </div>

                            <div class="form-check form-switch">
