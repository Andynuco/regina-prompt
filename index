    <div class="floating-shape" style="bottom: 10%; right: 7%; font-size: 4.5rem; animation-delay: 2s;">✨</div>
    <div class="floating-shape" style="top: 15%; right: 12%; font-size: 3.5rem; animation-delay: 4s;">💬</div>
    <div class="floating-shape" style="bottom: 15%; left: 10%; font-size: 3.5rem; animation-delay: 1s;">🎯</div>

