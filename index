                                </label>
                            </div>
                        </div>

                        <!-- Botón principal de generación -->
                        <div class="d-grid mb-4">
                            <button id="generateBtn" class="btn btn-generate">
                                <i class="bi bi-magic me-2"></i> GENERAR COPY CREATIVO
                            </button>
                        </div>

                        <!-- Área de visualización del copy generado -->
                        <div class="result-wrapper">
                            <div class="result-box">
                                <!-- Etiquetas informativas -->
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <div id="badgesContainer">
                                        <span class="badge-category bg-primary-subtle text-primary">Listo para crear</span>
                                    </div>
                                    <span class="text-muted small fw-semibold" id="charCounter">0 caracteres</span>
                                </div>

                                <!-- Texto del Copy con animación -->
                                <div id="copyOutputWrapper" class="my-2">
