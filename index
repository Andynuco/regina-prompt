    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Animate.css CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>

    <style>
        :root {
            --gradient-bg: linear-gradient(135deg, #FF6B6B 0%, #FFD93D 25%, #6BCB77 50%, #4D96FF 75%, #9B5DE5 100%);
            --card-bg: rgba(255, 255, 255, 0.94);
            --primary-grad: linear-gradient(90deg, #FF512F 0%, #DD2476 100%);
            --secondary-grad: linear-gradient(90deg, #4776E6 0%, #8E54E9 100%);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--gradient-bg);
            background-size: 300% 300%;
            animation: gradientFlow 15s ease infinite;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
            overflow-x: hidden;
        }

        @keyframes gradientFlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Decoraciones flotantes de fondo */
        .floating-shape {
            position: fixed;
            z-index: 0;
            opacity: 0.25;
            pointer-events: none;
            animation: floatAnim 6s ease-in-out infinite;
        }

        @keyframes floatAnim {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(8deg); }
        }

        .main-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            border-radius: 28px;
            border: 2px solid rgba(255, 255, 255, 0.7);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            position: relative;
            z-index: 10;
            overflow: hidden;
        }

        .header-banner {
            background: linear-gradient(120deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: white;
            padding: 2rem 1.5rem;
            position: relative;
            overflow: hidden;
        }

        .header-banner::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 250px;
            height: 250px;
            background: radial-gradient(circle, rgba(255,107,107,0.4) 0%, transparent 70%);
            border-radius: 50%;
        }

        .title-highlight {
            background: linear-gradient(90deg, #FFD93D, #FF6B6B);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
        }

        .form-select-custom {
            border-radius: 16px;
            border: 2px solid #e2e8f0;
            padding: 0.85rem 1.1rem;
            font-weight: 600;
            color: #1e293b;
            transition: all 0.25s ease;
            cursor: pointer;
            background-color: #f8fafc;
        }

        .form-select-custom:focus {
            border-color: #8E54E9;
            box-shadow: 0 0 0 4px rgba(142, 84, 233, 0.18);
            background-color: #ffffff;
        }

        .btn-generate {
            background: var(--primary-grad);
            border: none;
            border-radius: 18px;
            color: white;
            font-weight: 800;
            letter-spacing: 0.5px;
            padding: 1rem 2rem;
            font-size: 1.1rem;
            box-shadow: 0 10px 25px -5px rgba(221, 36, 118, 0.5);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-generate:hover {
            transform: translateY(-3px) scale(1.01);
            box-shadow: 0 15px 30px -5px rgba(221, 36, 118, 0.65);
            color: white;
        }

        .btn-generate:active {
            transform: translateY(1px);
        }

        /* Caja de resultado con borde arcoíris animado */
        .result-wrapper {
            position: relative;
            border-radius: 22px;
            padding: 3px;
            background: linear-gradient(90deg, #FF6B6B, #FFD93D, #6BCB77, #4D96FF, #9B5DE5, #FF6B6B);
            background-size: 300% 300%;
            animation: gradientFlow 6s linear infinite;
            box-shadow: 0 12px 24px -8px rgba(77, 150, 255, 0.25);
        }

        .result-box {
            background: #ffffff;
            border-radius: 19px;
            padding: 1.75rem;
            min-height: 170px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .copy-text-display {
            font-size: 1.2rem;
            line-height: 1.65;
            color: #1e293b;
            font-weight: 600;
            white-space: pre-line;
        }

        .hashtag-pill {
            display: inline-block;
            background: #f1f5f9;
            color: #4776E6;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            margin: 0.2rem;
            border: 1px solid #cbd5e1;
            transition: all 0.2s;
        }

        .hashtag-pill:hover {
            background: #4776E6;
            color: white;
            cursor: pointer;
        }

        .btn-copy {
            background: var(--secondary-grad);
            color: white;
            border: none;
            border-radius: 14px;
            font-weight: 700;
            padding: 0.6rem 1.25rem;
            transition: all 0.25s ease;
        }

        .btn-copy:hover {
            opacity: 0.92;
            transform: translateY(-2px);
            color: white;
        }

        .btn-copy.copied {
            background: linear-gradient(90deg, #10b981 0%, #059669 100%);
        }

        .badge-category {
            font-size: 0.78rem;
            font-weight: 700;
            padding: 0.4rem 0.85rem;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

