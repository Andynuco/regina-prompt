            cursor: pointer;
            border-radius: 12px;
            padding: 0.45rem 0.85rem;
            font-size: 0.85rem;
            font-weight: 600;
            border: 1.5px solid #e2e8f0;
            background: white;
            color: #475569;
            transition: all 0.2s;
        }

