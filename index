                                        <i class="bi bi-arrow-repeat me-1"></i> Otra idea
                                    </button>

                                    <button id="copyBtn" class="btn btn-copy btn-sm d-flex align-items-center gap-2">
                                        <i class="bi bi-clipboard-check" id="copyIcon"></i>
                                        <span id="copyBtnText">Copiar Copy</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>

