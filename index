                ],
                curiosidad: [
                    "🤔 ¿Cuál de estas 3 opciones elegirías tú: A, B o C? Déjanos tu respuesta en los comentarios y descubre qué dice tu elección sobre tu estilo. 👇💡",
                    "🔎 ¿Quieres descubrir el truco que usamos para ahorrar 5 horas a la semana? Visita el enlace de nuestra bio y descárgalo gratis hoy mismo. 👀📘",
                    "💭 Tenemos una pregunta para ti... ¿Qué es lo primero que harías si tuvieras tiempo ilimitado? ¡Te leemos en los comentarios! 👇✨"
                ],
                empatia: [
                    "💬 ¿Cómo te sientes hoy realmente? Este es un espacio seguro para compartir. Escríbenos en los comentarios o envíanos un mensaje, nos encantará leerte. 🤗💙",
                    "📌 Guarda esta publicación para esos días en los que necesites un poco de apoyo o inspiración. Y si conoces a alguien que la necesite hoy, envíasela. 🌿❤️",
                    "🤝 Estamos aquí para ayudarte a resolver tus dudas sin compromiso. Haz clic en el botón de mensaje y conversemos sobre cómo podemos apoyarte. ✨😊"
                ]
            }
        };

        /**
         * Hashtags sugeridos según la red social y categoría
         */
        const hashtagBank = {
            Instagram: ["#MarketingDigital", "#Emprendedores", "#ContenidoCreativo", "#Comunidad", "#InstaTips"],
            TikTok: ["#ParaTi", "#FYP", "#TipsDeMarketing", "#Emprendimiento", "#Viral"],
            Facebook: ["#NegociosOnline", "#Ofertas", "#InspiracionDiaria", "#ComunidadDigital"],
            LinkedIn: ["#MarcaPersonal", "#EstrategiaDigital", "#CrecimientoProfesional", "#Innovacion", "#Liderazgo"]
        };

        // Referencias al DOM
        const postTypeEl = document.getElementById('postType');
        const emotionTypeEl = document.getElementById('emotionType');
        const generateBtn = document.getElementById('generateBtn');
        const regenerateSmallBtn = document.getElementById('regenerateSmallBtn');
        const copyOutputEl = document.getElementById('copyOutput');
        const copyOutputWrapper = document.getElementById('copyOutputWrapper');
        const hashtagsContainer = document.getElementById('hashtagsContainer');
        const badgesContainer = document.getElementById('badgesContainer');
        const charCounter = document.getElementById('charCounter');
        const copyBtn = document.getElementById('copyBtn');
        const copyBtnText = document.getElementById('copyBtnText');
        const copyIcon = document.getElementById('copyIcon');
        const includeHashtagsSwitch = document.getElementById('includeHashtags');
        const networkChips = document.querySelectorAll('.social-chip');

        let selectedNetwork = 'Instagram';
        let lastGeneratedCopy = '';
        let currentFullTextToCopy = '';

        // Manejo de selección de Red Social
        networkChips.forEach(chip => {
            chip.addEventListener('click', () => {
                networkChips.forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
                selectedNetwork = chip.getAttribute('data-net');
                if (lastGeneratedCopy) {
                    updateDisplayAndCounter();
                }
            });
        });

        // Actualizar al cambiar el switch de hashtags
        includeHashtagsSwitch.addEventListener('change', () => {
            if (lastGeneratedCopy) {
                updateDisplayAndCounter();
            }
        });

        /**
         * Función para aplicar una animación de Animate.css limpiamente
         */
        function triggerAnimation(element, animationName) {
            element.classList.remove('animate__animated', animationName, 'animate__fadeIn', 'animate__zoomIn', 'animate__bounceIn');
            void element.offsetWidth; // Forzar reflow para reiniciar animación
            element.classList.add('animate__animated', animationName);
        }

        /**
         * Genera un copy aleatorio basado en las selecciones actuales
         */
        function generateCreativeCopy() {
            const type = postTypeEl.value;
            const emotion = emotionTypeEl.value;

            const options = copyDatabase[type][emotion];
            let randomCopy = options[Math.floor(Math.random() * options.length)];

            // Evitar repetir exactamente el mismo copy consecutivo si hay más de 1 opción
            if (options.length > 1 && randomCopy === lastGeneratedCopy) {
                const filtered = options.filter(item => item !== lastGeneratedCopy);
                randomCopy = filtered[Math.floor(Math.random() * filtered.length)];
            }

            lastGeneratedCopy = randomCopy;

            // Actualizar etiquetas descriptivas
            const typeText = postTypeEl.options[postTypeEl.selectedIndex].text;
            const emotionText = emotionTypeEl.options[emotionTypeEl.selectedIndex].text;

            badgesContainer.innerHTML = `
                <span class="badge-category bg-danger-subtle text-danger me-1">${typeText}</span>
                <span class="badge-category bg-info-subtle text-info-emphasis">${emotionText}</span>
            `;

            updateDisplayAndCounter();

            // Animar la aparición del copy con Animate.css
            triggerAnimation(copyOutputWrapper, 'animate__zoomIn');
            triggerAnimation(generateBtn, 'animate__pulse');

            // Resetear botón de copiar si estaba en estado "Copiado"
            resetCopyButton();
        }

        /**
         * Renderiza el texto, hashtags y contador de caracteres
         */
        function updateDisplayAndCounter() {
            copyOutputEl.textContent = lastGeneratedCopy;
            hashtagsContainer.innerHTML = '';

            let hashtagsText = '';
            if (includeHashtagsSwitch.checked) {
                const tags = hashtagBank[selectedNetwork] || hashtagBank['Instagram'];
                // Seleccionar 4 hashtags aleatorios de la red elegida
                const shuffledTags = [...tags].sort(() => 0.5 - Math.random()).slice(0, 4);
                hashtagsText = '\n\n' + shuffledTags.join(' ');

                shuffledTags.forEach(tag => {
                    const span = document.createElement('span');
                    span.className = 'hashtag-pill animate__animated animate__fadeIn';
                    span.textContent = tag;
                    span.title = 'Clic para quitar este hashtag';
                    span.addEventListener('click', () => {
                        span.remove();
                        recalculateFullText();
                    });
                    hashtagsContainer.appendChild(span);
                });
            }

            recalculateFullText();
        }

        /**
         * Recalcula el texto final incluyendo los hashtags visibles en pantalla
         */
        function recalculateFullText() {
            const visibleTags = Array.from(hashtagsContainer.querySelectorAll('.hashtag-pill'))
                                     .map(el => el.textContent);
            
            if (visibleTags.length > 0) {
                currentFullTextToCopy = `${lastGeneratedCopy}\n\n${visibleTags.join(' ')}`;
            } else {
                currentFullTextToCopy = lastGeneratedCopy;
            }

            charCounter.textContent = `${currentFullTextToCopy.length} caracteres (${selectedNetwork})`;
        }

        /**
         * Copia el texto al portapapeles de forma segura (compatible con iFrames)
         */
        function copyToClipboard() {
            const textToCopy = currentFullTextToCopy || copyOutputEl.innerText;

            const tempTextarea = document.createElement('textarea');
            tempTextarea.value = textToCopy;
            tempTextarea.style.position = 'fixed';
            tempTextarea.style.left = '-9999px';
            document.body.appendChild(tempTextarea);
            tempTextarea.select();

            try {
                document.execCommand('copy');
                showCopiedFeedback();
            } catch (err) {
                console.error('Error al copiar texto:', err);
            } finally {
                document.body.removeChild(tempTextarea);
            }
        }

        function showCopiedFeedback() {
            copyBtn.classList.add('copied');
            copyIcon.className = 'bi bi-check2-circle';
            copyBtnText.textContent = '¡Copiado!';
            triggerAnimation(copyBtn, 'animate__bounceIn');

            setTimeout(() => {
                resetCopyButton();
            }, 2200);
        }

        function resetCopyButton() {
            copyBtn.classList.remove('copied');
            copyIcon.className = 'bi bi-clipboard-check';
            copyBtnText.textContent = 'Copiar Copy';
        }

        // Event Listeners
        generateBtn.addEventListener('click', generateCreativeCopy);
        regenerateSmallBtn.addEventListener('click', generateCreativeCopy);
        copyBtn.addEventListener('click', copyToClipboard);

        // Generar un primer copy automáticamente al cargar la página
        window.addEventListener('DOMContentLoaded', () => {
            generateCreativeCopy();
        });
    </script>
</body>
</html>